# =====================================================================
# IntentG — whitelist-style .gitignore
# Only the clean algorithm/model code, training/evaluation entry points,
# paper visualization scripts, the user guide and experiment_revise/
# are tracked. Everything else at the repository root (data, outputs,
# checkpoints, figures, videos, analysis/benchmark scripts, notes, ...)
# is ignored by default. To track a new top-level file, add a "!/name"
# line below.
# =====================================================================

# 1) Ignore everything at the repository root ...
/*

# 2) ... except these files
!/.gitignore
!/requirements.txt
!/user_guide.md
!/preprocess.py
!/train.py
!/eval.py
!/vis_paper.py
!/vis_gif_combine.py

# 3) ... and these directories
!/conf/
!/src/
!/experiment_revise/

# ---------------------------------------------------------------------
# Excluded inside the whitelisted directories
# ---------------------------------------------------------------------
# Experiment outputs (checkpoints, logs, csv/png summaries)
experiment_revise/results/
experiment_revise/**/*.ckpt

# Data / results / figures, wherever they appear
data/
outputs/
checkpoints/
ckpts/
submission/
*.ckpt
*.pt
*.pth
*.pkl
*.parquet
*.png
*.jpg
*.jpeg
*.pdf
*.gif
*.mp4
*.docx
*.log

# Python byte-code / caches
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# Environments / editors
.env
.venv/
env/
venv/
.vscode/
.idea/
